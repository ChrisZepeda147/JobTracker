# Copy to .env and fill in. .env is gitignored.
#
# The pipeline is designed to run at ZERO cost. Every AI provider below has a
# free tier that needs no credit card, and if you supply no keys at all it falls
# back to a local TF-IDF scorer that never touches the network.

# ===============================================================
# AI PROVIDERS  (all optional - the pipeline works with none of them)
# ===============================================================
# Priority order: Gemini -> Groq -> Cohere -> Anthropic -> local TF-IDF.
# If one provider errors or hits its rate limit mid-run, the remaining jobs
# automatically move to the next provider. Scoring can never hard-fail.

# --- Priority 1: Google Gemini (FREE, no credit card) ---------------------
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with any Google account.
# 3. Click "Create API key". A project is created for you automatically.
# 4. Copy the key and paste it below.
# Free tier: roughly 15 requests/minute and 1,000 requests/day on flash-lite,
# which is far more than this pipeline needs. No billing setup required.
GEMINI_API_KEY=

# Optional override. Default is gemini-3.5-flash-lite (highest free quota).
# Other free options: gemini-3.6-flash, gemini-flash-lite-latest
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Priority 2: Groq (FREE, no credit card) ------------------------------
# 1. Go to https://console.groq.com/keys
# 2. Sign up with Google, GitHub, or email.
# 3. Click "Create API Key" and copy it (shown only once).
# Free tier: about 30 requests/minute. No billing setup required.
GROQ_API_KEY=

# Optional override. Default is openai/gpt-oss-20b.
# NOTE: Groq no longer serves Llama 3 chat models. Current free chat models are
# openai/gpt-oss-20b, openai/gpt-oss-120b, and qwen/qwen3.6-27b.
# GROQ_MODEL=openai/gpt-oss-20b

# --- Priority 3: Cohere (FREE trial key, no credit card) ------------------
# 1. Go to https://dashboard.cohere.com/api-keys
# 2. Sign up with Google, GitHub, or email.
# 3. Copy the "Trial" key (the free one). Do NOT create a Production key,
#    which requires billing.
# Trial keys allow about 20 requests/minute and 1,000 calls per MONTH. That
# monthly cap is why Cohere sits below Gemini and Groq, which reset daily.
# Trial keys are for non-commercial use.
COHERE_API_KEY=

# Optional override. Default is command-a-03-2025 (flagship).
# Lighter options: command-r-08-2024, command-r7b-12-2024
# COHERE_MODEL=command-a-03-2025

# --- Priority 4: Anthropic Claude (PAID - leave blank to stay free) -------
# Only used if the free providers above are absent or exhausted.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Priority 5: local TF-IDF (always available, no key needed) -----------
# Nothing to configure. Used automatically when no provider above responds.

# How many top candidates get sent to an AI provider per run. The rest are
# scored locally. Keeps you comfortably inside the free rate limits.
# MAX_JOBS_TO_SCORE=20

# Max new jobs surfaced to the user per search request (after filter + rank).
# DAILY_JOB_LIMIT=15

# ===============================================================
# SUPABASE  (free tier, no credit card: https://supabase.com)
# ===============================================================
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Settings -> API Keys.
# Writes REQUIRE the secret (service_role) key; the publishable key is blocked
# from inserting by row level security.
SUPABASE_KEY=sb_secret_...

# Explicit alternatives, checked before SUPABASE_KEY:
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ===============================================================
# SCRAPING (optional)
# ===============================================================
# Rotating residential proxies for boards that block home IPs
# (ZipRecruiter and Glassdoor commonly return 403).
# PROXY_LIST=user:pass@host1:port,user:pass@host2:port

# ===============================================================
# WEB APP (Next.js in /web — browser-safe keys only)
# ===============================================================
# Copy web/.env.local.example to web/.env.local and use the SAME
# SUPABASE_URL plus your publishable/anon key. Never expose the
# service role key to the browser.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
